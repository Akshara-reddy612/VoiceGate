# Copy to .env and fill in. Never commit .env.

# LiveKit (needed only for the voice agent). LiveKit Cloud project or local livekit-server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Gemini API key from Google AI Studio (needed only for voice / LLM text mode).
GOOGLE_API_KEY=your-google-api-key

# Owner dashboard login (Phase 3).
OWNER_PASSWORD=change-me

# SQLite database file.
VOICEGATE_DB_PATH=voicegate.db
